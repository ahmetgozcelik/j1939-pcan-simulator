{
  "version": "1.0",
  "notes": [
    "DM1 lamp status is defined by SAE J1939-73 byte 1 as four 2-bit fields.",
    "Use bit positions 6, 4, 2, and 0 only. Labels and display order can be changed here.",
    "FMI descriptions can be customized without changing DM1 frame encoding."
  ],
  "lamp_statuses": [
    {
      "key": "red",
      "label": "Red Stop Lamp",
      "bit": 4
    },
    {
      "key": "amber",
      "label": "Amber Warning Lamp",
      "bit": 2
    },
    {
      "key": "protect",
      "label": "Protect Lamp",
      "bit": 0
    },
    {
      "key": "mil",
      "label": "MIL (Malfunction Indicator Lamp)",
      "bit": 6
    }
  ],
  "fmi_descriptions": {
    "0": "Above normal / most severe",
    "1": "Below normal / most severe",
    "2": "Erratic, intermittent or incorrect",
    "3": "Voltage above normal",
    "4": "Voltage below normal",
    "5": "Current below normal / open circuit",
    "6": "Current above normal / grounded",
    "7": "Mechanical system not responding",
    "8": "Abnormal frequency / pulse width",
    "9": "Abnormal update rate",
    "10": "Abnormal rate of change",
    "11": "Root cause unknown",
    "12": "Bad intelligent device or component",
    "13": "Out of calibration",
    "14": "Special instructions",
    "15": "Above normal / least severe",
    "16": "Above normal / moderately severe",
    "17": "Below normal / least severe",
    "18": "Below normal / moderately severe",
    "19": "Network error",
    "20": "Data drifted high",
    "21": "Data drifted low",
    "31": "Condition exists"
  }
}
