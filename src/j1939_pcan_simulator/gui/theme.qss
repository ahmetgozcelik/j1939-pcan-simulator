/*
Theme tokens - SAE J1939 defense/industrial HMI

--bg-base: #0D1117;
--bg-panel: #161B22;
--bg-panel-hover: #1C2229;
--bg-input: #0D1117;
--border-subtle: rgba(255,255,255,0.08);
--border-strong: rgba(255,255,255,0.16);
--text-primary: #E6EDF3;
--text-secondary: #8B949E;
--text-disabled: #4D555E;
--accent-cyan: #4FC3F7;
--status-ok: #3ADB76;
--status-warn: #FFB000;
--status-error: #FF3B30;
*/

QWidget {
    background-color: #0D1117;
    color: #E6EDF3;
    font-size: 10pt;
}

QMainWindow,
QMenuBar,
QStatusBar {
    background-color: #0D1117;
    color: #E6EDF3;
}

QMenuBar {
    border-bottom: 1px solid rgba(255,255,255,0.08);
}

QMenuBar::item {
    background-color: transparent;
    padding: 5px 10px;
}

QMenuBar::item:selected,
QMenu {
    background-color: #161B22;
    border: 1px solid rgba(255,255,255,0.16);
}

QMenu::item {
    padding: 6px 28px 6px 12px;
}

QMenu::item:selected {
    background-color: rgba(79,195,247,0.18);
    color: #E6EDF3;
}

QToolBar#MainToolBar {
    background-color: #111820;
    border-top: 1px solid rgba(255,255,255,0.08);
    border-bottom: 1px solid rgba(255,255,255,0.16);
    spacing: 8px;
    padding: 8px 10px;
}

QToolBar#MainToolBar QToolButton,
QToolButton {
    background-color: #161B22;
    border: 1px solid rgba(255,255,255,0.10);
    border-radius: 6px;
    color: #E6EDF3;
    padding: 7px 11px;
    min-height: 24px;
    font-weight: 650;
}

QToolBar#MainToolBar QToolButton:hover,
QToolButton:hover {
    background-color: #1C2229;
    border-color: rgba(255,255,255,0.16);
}

QToolBar#MainToolBar QToolButton:pressed,
QToolButton:pressed {
    background-color: rgba(79,195,247,0.18);
    border-color: #4FC3F7;
}

QToolBar#MainToolBar QToolButton:checked {
    background-color: rgba(79,195,247,0.14);
    border-color: #4FC3F7;
}

QToolButton::menu-indicator {
    image: none;
    width: 0;
}

QToolBar::separator {
    background-color: rgba(255,255,255,0.16);
    width: 1px;
    margin: 6px 8px;
}

QSplitter::handle {
    background-color: #1C2229;
}

QSplitter::handle:horizontal {
    width: 10px;
    border-left: 1px solid rgba(255,255,255,0.08);
    border-right: 1px solid rgba(255,255,255,0.08);
}

QSplitter::handle:horizontal:hover {
    background-color: rgba(79,195,247,0.18);
    border-left: 1px solid #4FC3F7;
    border-right: 1px solid #4FC3F7;
}

QDockWidget {
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
    color: #E6EDF3;
    border-top: 1px solid rgba(255,255,255,0.16);
}

QDockWidget::title {
    background-color: #161B22;
    color: #8B949E;
    text-transform: uppercase;
    padding: 5px 8px;
    border-top: 1px solid rgba(255,255,255,0.16);
}

QPushButton#ValidationStatusButton {
    background-color: transparent;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 5px;
    padding: 3px 10px;
    min-height: 20px;
    font-weight: 700;
}

QPushButton#ValidationStatusButton[state="ok"] {
    color: #3ADB76;
    border-color: rgba(58,219,118,0.36);
}

QPushButton#ValidationStatusButton[state="warn"] {
    color: #FFB000;
    border-color: rgba(255,176,0,0.46);
}

QPushButton#ValidationStatusButton[state="error"] {
    color: #FF3B30;
    border-color: rgba(255,59,48,0.56);
    background-color: rgba(255,59,48,0.08);
}

QPushButton#ValidationStatusButton:hover {
    background-color: #1C2229;
    border-color: #4FC3F7;
}

QLabel#ValidationSummary {
    color: #E6EDF3;
    background-color: #161B22;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 6px;
    padding: 7px 10px;
    font-weight: 700;
}

QLabel#ValidationSummary[state="ok"] {
    color: #3ADB76;
    border-color: rgba(58,219,118,0.36);
}

QLabel#ValidationSummary[state="warn"] {
    color: #FFB000;
    border-color: rgba(255,176,0,0.46);
}

QLabel#ValidationSummary[state="error"] {
    color: #FF3B30;
    border-color: rgba(255,59,48,0.56);
}

QFrame#PanelSurface,
QWidget#ConnectionBadge {
    background-color: #161B22;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 6px;
}

QWidget#ConnectionBadge[state="ok"] {
    border-color: rgba(58,219,118,0.48);
    background-color: rgba(58,219,118,0.10);
}

QWidget#ConnectionBadge[state="error"] {
    border-color: rgba(255,59,48,0.56);
    background-color: rgba(255,59,48,0.12);
}

QLabel#ConnectionStatusLabel {
    color: #E6EDF3;
    font-weight: 600;
    padding-right: 6px;
}

QLabel#statusLed,
QLabel#ConnectionLed {
    border-radius: 6px;
    min-width: 12px;
    max-width: 12px;
    min-height: 12px;
    max-height: 12px;
    border: 1px solid #4D555E;
    background-color: transparent;
}

QLabel#ConnectionLed[state="ok"] {
    background-color: #3ADB76;
    border-color: #3ADB76;
}

QLabel#ConnectionLed[state="error"] {
    background-color: #FF3B30;
    border-color: #FF3B30;
}

QTableView {
    background-color: #0D1117;
    alternate-background-color: #161B22;
    color: #E6EDF3;
    gridline-color: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 6px;
    selection-background-color: rgba(79,195,247,0.16);
    selection-color: #E6EDF3;
}

QTableView::item {
    padding: 0 6px;
    border: none;
}

QTableView::item:hover {
    background-color: #1C2229;
}

QTableView::item:selected {
    background-color: rgba(79,195,247,0.16);
    color: #E6EDF3;
    border-left: 3px solid #4FC3F7;
}

QHeaderView::section {
    background-color: #161B22;
    color: #E6EDF3;
    padding: 7px 8px;
    border: none;
    border-right: 1px solid rgba(255,255,255,0.08);
    border-bottom: 1px solid rgba(255,255,255,0.16);
    font-weight: 700;
}

QHeaderView::section:hover {
    background-color: #1C2229;
    border-right: 1px solid #4FC3F7;
}

QLineEdit,
QSpinBox,
QDoubleSpinBox,
QComboBox {
    background-color: #0D1117;
    color: #E6EDF3;
    border: 1px solid rgba(255,255,255,0.16);
    border-radius: 5px;
    padding: 5px 8px;
    min-height: 24px;
    selection-background-color: rgba(79,195,247,0.30);
}

QSpinBox,
QDoubleSpinBox,
QLineEdit[mono="true"],
QLabel#J1939Value,
QLabel#FrameBytes,
QTableView[mono="true"] {
}

QLineEdit:hover,
QSpinBox:hover,
QDoubleSpinBox:hover,
QComboBox:hover {
    border-color: rgba(255,255,255,0.26);
}

QLineEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QComboBox:focus {
    border-color: #4FC3F7;
}

QDoubleSpinBox[invalid="true"],
QSpinBox[invalid="true"] {
    border-color: #FF3B30;
    background-color: rgba(255,59,48,0.08);
}

QComboBox::drop-down {
    border-left: 1px solid rgba(255,255,255,0.08);
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: #161B22;
    border: 1px solid rgba(255,255,255,0.16);
    selection-background-color: rgba(79,195,247,0.18);
    color: #E6EDF3;
}

QPushButton {
    background-color: #161B22;
    color: #E6EDF3;
    border: 1px solid rgba(255,255,255,0.16);
    border-radius: 6px;
    padding: 7px 14px;
    min-height: 22px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #1C2229;
    border-color: rgba(255,255,255,0.28);
}

QPushButton:pressed {
    background-color: rgba(79,195,247,0.18);
    border-color: #4FC3F7;
}

QPushButton:disabled {
    color: #4D555E;
    background-color: #0D1117;
    border-color: rgba(255,255,255,0.08);
}

QPushButton#ReconnectButton {
    border-color: #FFB000;
    color: #FFB000;
    font-weight: 700;
}

QPushButton#ReconnectButton:hover {
    background-color: rgba(255,176,0,0.10);
}

QGroupBox {
    background-color: #161B22;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 6px;
    margin-top: 18px;
    padding: 16px 12px 12px 12px;
}

QGroupBox:hover {
    border-color: rgba(255,255,255,0.16);
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 6px;
    color: #8B949E;
    background-color: #0D1117;
    font-size: 8.5pt;
    font-weight: 700;
}

QLabel {
    background-color: transparent;
}

QLabel#SignalDetailTitle {
    color: #E6EDF3;
    font-size: 11pt;
    font-weight: 700;
}

QLabel#J1939Value {
    color: #E6EDF3;
    font-size: 10.5pt;
    font-weight: 700;
}

QLabel#ScaleError {
    color: #FF3B30;
    font-weight: 600;
}

QLabel#SecondaryText {
    color: #8B949E;
    font-size: 9pt;
}

QLabel#LampMatrixHeader {
    color: #8B949E;
    font-size: 8.5pt;
    font-weight: 700;
}

QLabel#LampMatrixLabel {
    color: #E6EDF3;
    font-weight: 600;
    padding: 5px 0;
}

QWidget#LampMatrix {
    background-color: #0D1117;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 6px;
    padding: 8px;
}

QToolButton#LampStatusTile {
    min-height: 30px;
    color: #8B949E;
    background-color: #161B22;
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 5px;
    font-weight: 800;
    padding: 4px 10px;
}

QToolButton#LampStatusTile:hover {
    border-color: rgba(79,195,247,0.65);
}

QToolButton#LampStatusTile:pressed {
    background-color: rgba(79,195,247,0.14);
}

QToolButton#LampStatusTile[active="true"] {
    color: #0D1117;
    background-color: #3ADB76;
    border-color: #3ADB76;
}

QToolButton#LampStatusTile:disabled {
    color: #4D555E;
    background-color: #0D1117;
    border-color: rgba(255,255,255,0.08);
}

QLabel#FrameBytes {
    color: #E6EDF3;
    background-color: #0D1117;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 5px;
    padding: 8px 10px;
    font-size: 11.5pt;
    font-weight: 700;
}

QPlainTextEdit {
    background-color: #0D1117;
    color: #E6EDF3;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 6px;
}

QPlainTextEdit#ValidationDetail {
    background-color: #161B22;
    color: #E6EDF3;
    border: 1px solid rgba(79,195,247,0.20);
    padding: 6px 8px;
    font-family: "JetBrains Mono", "Consolas", "Cascadia Code";
    font-size: 9.5pt;
}

QListWidget {
    background-color: #0D1117;
    color: #E6EDF3;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 6px;
}

QListWidget::item {
    min-height: 28px;
    padding: 4px 8px;
}

QListWidget::item:selected {
    background-color: rgba(79,195,247,0.16);
    color: #E6EDF3;
    border-left: 3px solid #4FC3F7;
}

QCheckBox {
    spacing: 8px;
    color: #E6EDF3;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1px solid rgba(255,255,255,0.16);
    background-color: #0D1117;
}

QCheckBox::indicator:hover {
    border-color: #4FC3F7;
}

QCheckBox::indicator:checked {
    background-color: #4FC3F7;
    border-color: #4FC3F7;
}

QScrollArea {
    background-color: #0D1117;
    border: none;
}

QScrollBar:vertical,
QScrollBar:horizontal {
    background-color: #0D1117;
    border: none;
    width: 12px;
    height: 12px;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background-color: #4D555E;
    border-radius: 5px;
    min-height: 24px;
    min-width: 24px;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background-color: #8B949E;
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
    border: none;
}
